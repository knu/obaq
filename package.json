{
  "name": "obaq",
  "version": "1.0.0",
  "description": "CLI query processor for Obsidian Bases",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "obaq": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "prettier --write 'src/**/*.ts' 'test-vault/**/*.base'",
    "lint": "eslint src --ext .ts",
    "test": "npm run build && node --test $(find dist -name '*.test.js')",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "query",
    "cli"
  ],
  "author": "Akinori Musha <knu@idaemons.org>",
  "license": "BSD-2-Clause",
  "dependencies": {
    "csv-stringify": "^6.6.0",
    "dayjs": "^1.11.18",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mdast-util-wiki-link": "^0.1.2",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "remark-wiki-link": "^2.0.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.8.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
